graph ER {
graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.0, pad=0.4, fontname="Helvetica", label=<<b>Stationary Shop - Entity-Relationship Diagram</b>>, labelloc=t, fontsize=26];
node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica-Bold", fontsize=13, color="#1b2559", fontcolor="#3d4fd1"];
CATEGORY [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>CATEGORY</b></font></td></tr><tr><td align="left"><u><b>category_id</b></u></td></tr><tr><td align="left">category_name (UK)</td></tr><tr><td align="left">description</td></tr></table>>];
SUPPLIER [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>SUPPLIER</b></font></td></tr><tr><td align="left"><u><b>supplier_id</b></u></td></tr><tr><td align="left">supplier_name</td></tr><tr><td align="left">contact_person</td></tr><tr><td align="left">phone</td></tr><tr><td align="left">email (UK)</td></tr><tr><td align="left">city</td></tr></table>>];
PRODUCT [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>PRODUCT</b></font></td></tr><tr><td align="left"><u><b>product_id</b></u></td></tr><tr><td align="left">product_name</td></tr><tr><td align="left">brand</td></tr><tr><td align="left"><i>category_id</i> (FK)</td></tr><tr><td align="left"><i>supplier_id</i> (FK)</td></tr><tr><td align="left">cost_price</td></tr><tr><td align="left">price</td></tr><tr><td align="left">stock_qty</td></tr><tr><td align="left">reorder_level</td></tr><tr><td align="left">is_active</td></tr><tr><td align="left">created_at</td></tr></table>>];
CUSTOMER [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>CUSTOMER</b></font></td></tr><tr><td align="left"><u><b>customer_id</b></u></td></tr><tr><td align="left">customer_name</td></tr><tr><td align="left">phone (UK)</td></tr><tr><td align="left">email (UK)</td></tr><tr><td align="left">city</td></tr><tr><td align="left">loyalty_points</td></tr><tr><td align="left">joined_on</td></tr></table>>];
EMPLOYEE [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>EMPLOYEE</b></font></td></tr><tr><td align="left"><u><b>emp_id</b></u></td></tr><tr><td align="left">emp_name</td></tr><tr><td align="left">role</td></tr><tr><td align="left">phone</td></tr><tr><td align="left">salary</td></tr><tr><td align="left">hired_on</td></tr></table>>];
ORDER [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>ORDER</b></font></td></tr><tr><td align="left"><u><b>order_id</b></u></td></tr><tr><td align="left"><i>customer_id</i> (FK)</td></tr><tr><td align="left"><i>emp_id</i> (FK)</td></tr><tr><td align="left">order_date</td></tr><tr><td align="left">discount_percent</td></tr><tr><td align="left">status</td></tr><tr><td align="left">request_key (UK)</td></tr></table>>];
PAYMENT [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>PAYMENT</b></font></td></tr><tr><td align="left"><u><b>payment_id</b></u></td></tr><tr><td align="left"><i>order_id</i> (FK, UK)</td></tr><tr><td align="left">amount</td></tr><tr><td align="left">method</td></tr><tr><td align="left">paid_at</td></tr></table>>];
PURCHASE_ORDER [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>PURCHASE ORDER</b></font></td></tr><tr><td align="left"><u><b>po_id</b></u></td></tr><tr><td align="left"><i>supplier_id</i> (FK)</td></tr><tr><td align="left">po_date</td></tr><tr><td align="left">status</td></tr></table>>];
STOCK_LOG [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white" color="#1b2559"><tr><td bgcolor="#1b2559"><font color="white"><b>STOCK LOG</b></font></td></tr><tr><td align="left"><u><b>log_id</b></u></td></tr><tr><td align="left"><i>product_id</i> (FK)</td></tr><tr><td align="left">change_qty</td></tr><tr><td align="left">reason</td></tr><tr><td align="left">logged_at</td></tr></table>>];
R0 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Classified under", width=1.5, height=0.9];
CATEGORY -- R0 [label="1", color="#1b2559"];
R0 -- PRODUCT [label="N", color="#1b2559:#1b2559"];
R1 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Supplies", width=1.5, height=0.9];
SUPPLIER -- R1 [label="1", color="#1b2559"];
R1 -- PRODUCT [label="N", color="#1b2559"];
R2 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Places", width=1.5, height=0.9];
CUSTOMER -- R2 [label="1", color="#1b2559"];
R2 -- ORDER [label="N", color="#1b2559"];
R3 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Handles", width=1.5, height=0.9];
EMPLOYEE -- R3 [label="1", color="#1b2559"];
R3 -- ORDER [label="N", color="#1b2559:#1b2559"];
R4 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Contains", width=1.5, height=0.9];
ORDER -- R4 [label="M", color="#1b2559:#1b2559"];
R4 -- PRODUCT [label="N", color="#1b2559"];
A4_0 [shape=ellipse, style=filled, fillcolor="#e9ecff", color="#3d4fd1", label=<<u>item_id</u>>, fontsize=10];
R4 -- A4_0 [color="#3d4fd1", style=dashed];
A4_1 [shape=ellipse, style=filled, fillcolor="#e9ecff", color="#3d4fd1", label=<quantity>, fontsize=10];
R4 -- A4_1 [color="#3d4fd1", style=dashed];
A4_2 [shape=ellipse, style=filled, fillcolor="#e9ecff", color="#3d4fd1", label=<unit_price>, fontsize=10];
R4 -- A4_2 [color="#3d4fd1", style=dashed];
A4_3 [shape=ellipse, style=filled, fillcolor="#e9ecff", color="#3d4fd1", label=<line_total>, fontsize=10];
R4 -- A4_3 [color="#3d4fd1", style=dashed];
R5 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Paid by", width=1.5, height=0.9];
ORDER -- R5 [label="1", color="#1b2559"];
R5 -- PAYMENT [label="1", color="#1b2559:#1b2559"];
R6 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Raises", width=1.5, height=0.9];
SUPPLIER -- R6 [label="1", color="#1b2559"];
R6 -- PURCHASE_ORDER [label="N", color="#1b2559:#1b2559"];
R7 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Includes", width=1.5, height=0.9];
PURCHASE_ORDER -- R7 [label="M", color="#1b2559"];
R7 -- PRODUCT [label="N", color="#1b2559"];
A7_0 [shape=ellipse, style=filled, fillcolor="#e9ecff", color="#3d4fd1", label=<<u>po_item_id</u>>, fontsize=10];
R7 -- A7_0 [color="#3d4fd1", style=dashed];
A7_1 [shape=ellipse, style=filled, fillcolor="#e9ecff", color="#3d4fd1", label=<quantity>, fontsize=10];
R7 -- A7_1 [color="#3d4fd1", style=dashed];
A7_2 [shape=ellipse, style=filled, fillcolor="#e9ecff", color="#3d4fd1", label=<unit_cost>, fontsize=10];
R7 -- A7_2 [color="#3d4fd1", style=dashed];
R8 [shape=diamond, style=filled, fillcolor="#fde9a8", color="#1b2559", label="Logged in", width=1.5, height=0.9];
PRODUCT -- R8 [label="1", color="#1b2559"];
R8 -- STOCK_LOG [label="N", color="#1b2559:#1b2559"];
legend [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td align="left"><b>Legend</b></td></tr><tr><td align="left">Rectangle = entity; diamond = relationship; ellipse = relationship attribute</td></tr><tr><td align="left"><u><b>underlined</b></u> = primary key; <i>italic (FK)</i> = foreign key; (UK) = unique key</td></tr><tr><td align="left">Double line = total participation; single line = partial participation</td></tr><tr><td align="left">1 / N / M = cardinality (one / many)</td></tr></table>>];
}