# Copy these values into your terminal session (see README section 7). Spring Boot reads them as environment variables.
# NEVER commit a real password. Do not create a file called .env with real credentials inside the project.
DB_URL=jdbc:postgresql://localhost:5432/stationary_shop
DB_USERNAME=postgres
DB_PASSWORD=your_local_password
# Optional
PORT=8080
# Only if the frontend is opened from another address (e.g. VS Code Live Server):
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Only for the optional integration tests (a SEPARATE database - it is reset by the tests!):
TEST_DB_URL=jdbc:postgresql://localhost:5432/stationary_shop_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=your_local_password
